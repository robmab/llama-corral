# EXAMPLE Git Bash aliases for the LLM repo. To use it:
#   1. cp aliases.sh.example aliases.sh   (aliases.sh is not committed)
#   2. Set LLM and DEFAULT_MODEL below.
#   3. In C:\Program Files\Git\etc\profile.d\aliases.sh keep only:
#        [ -f /d/LLM/aliases.sh ] && . /d/LLM/aliases.sh
#      (with your path) and open a new Git Bash terminal.
#
# Repo layout:
#   Models/   one .gguf (and its mmproj) per model
#   Router/   router.sh + models.ini (the only model configuration) + Open WebUI
#   Servers/  llama.cpp builds (active one: SERVER_BUILD in llm.conf)
#   Tests/    tests (llama test)
#   llm.conf  general configuration (active build)

# ------------------------------------------------------------------ SET THIS
# Repo path in Git Bash format (D:\LLM -> /d/LLM).
LLM="/c/path/to/LLM"
# Profile preloaded by "llama start" with no argument: id of a section of Router/models.ini.
DEFAULT_MODEL="My-Coder-Model"
# -----------------------------------------------------------------------------
LLM_CONF="$LLM/llm.conf"
ROUTER="$LLM/Router/router.sh"
TESTS="$LLM/Tests"

# Profile ids in Router/models.ini (section names, without [*]), on one line.
router_models() {
  grep -oE '^\[[^]*]+\]' "$LLM/Router/models.ini" 2>/dev/null | tr -d '[]' | paste -sd'|' | sed 's/|/ | /g'
}

# Active build according to llm.conf (empty if not set).
active_build() {
  # shellcheck source=/dev/null
  (SERVER_BUILD=""; [ -f "$LLM_CONF" ] && . "$LLM_CONF"; echo "$SERVER_BUILD")
}

# No argument: lists the builds in Servers/ and marks the active one.
# With an argument: makes it the active build in llm.conf (if it has llama-server.exe).
server_cmd() {
  local active; active="$(active_build)"
  if [ -z "$1" ]; then
    echo "Builds in $LLM/Servers (active: ${active:-none}):"
    local d name
    for d in "$LLM/Servers"/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      [ -f "$d/llama-server.exe" ] || { echo "    $name  (no llama-server.exe)"; continue; }
      [ "$name" = "$active" ] && echo "  * $name" || echo "    $name"
    done
    echo "Switch: llama server <folder>"
    return 0
  fi
  local new="${1%/}"
  if [ ! -f "$LLM/Servers/$new/llama-server.exe" ]; then
    echo "$LLM/Servers/$new/llama-server.exe does not exist"; return 1
  fi
  if [ "$new" = "$active" ]; then echo "$new is already the active build"; return 0; fi
  if grep -q '^SERVER_BUILD=' "$LLM_CONF" 2>/dev/null; then
    sed -i "s|^SERVER_BUILD=.*|SERVER_BUILD=\"$new\"|" "$LLM_CONF"
  else
    echo "SERVER_BUILD=\"$new\"" >> "$LLM_CONF"
  fi
  echo "Active build: $new  (was: ${active:-none})"
  if curl -s -o /dev/null --max-time 2 http://localhost:10001/health; then
    echo "The running router still uses the old one: llama stop and llama start to use the new one"
  fi
}

# --- Router (Router/models.ini): a single server on :10001 for Copilot and Open WebUI ---
# Shows the router models and which one is loaded (or says there is no router).
router_status() {
  curl -s --max-time 3 -H "Authorization: Bearer apikey" http://localhost:10001/models 2>/dev/null |
    python -c "
import json,sys
try: d=json.load(sys.stdin)['data']
except Exception: print('No router on :10001 (start it with: llama start)'); sys.exit()
for m in d:
    st=(m.get('status') or {}).get('value','?')
    print(('  * ' if st=='loaded' else '    ')+m['id']+'  ['+st+']')
"
}

# Starts the router in the background and preloads a model (DEFAULT_MODEL by default).
router_start() {
  local model="${1:-$DEFAULT_MODEL}"
  local log="$LLM/Router/webui/logs/router.log"
  if curl -s -o /dev/null --max-time 2 http://localhost:10001/health; then
    echo "A server is already running on :10001:"
    router_status; return 0
  fi
  mkdir -p "$(dirname "$log")"
  nohup "$ROUTER" > "$log" 2>&1 &
  echo "Router starting (log: $log)"
  for _ in $(seq 1 30); do curl -s -o /dev/null --max-time 2 http://localhost:10001/health && break; sleep 1; done
  echo "Loading $model..."
  curl -s -o /dev/null -H "Authorization: Bearer apikey" -H "Content-Type: application/json" \
    -d "{\"model\":\"$model\"}" http://localhost:10001/models/load
  for _ in $(seq 1 120); do
    router_status | grep -q "\* $model " && break
    sleep 1
  done
  router_status
}

llama() {
  case "$1" in
    start)
      # Router with DEFAULT_MODEL preloaded (or the given model).
      # Copilot and Open WebUI switch models on their own when another one is picked.
      router_start "$2"
      ;;
    stop)
      taskkill //IM llama-server.exe //F > /dev/null 2>&1 && echo "llama-server stopped" || echo "No llama-server was running"
      ;;
    status)
      echo "Build: $(active_build)  (llm.conf)"
      router_status
      ;;
    server)
      # llama.cpp builds: show which one is used or switch it (llama server <folder>)
      server_cmd "$2"
      ;;
    router)
      # Same as start but in the foreground (Ctrl+C to stop).
      PRELOAD="$2" "$ROUTER"
      ;;
    vram)
      # VRAM health: if "shared" goes above ~1.2 GB, part of the model is in RAM
      # (overflowed, or VRAM degraded by Windows) and everything is slower.
      # Single quotes on purpose: the $ variables belong to PowerShell, not bash.
      # shellcheck disable=SC2016
      powershell -NoProfile -Command '$ids=@((Get-Process llama-server -EA SilentlyContinue).Id); if(-not $ids){"No llama-server running"; exit}; $d=0;$s=0; (Get-Counter "\GPU Process Memory(*)\Dedicated Usage","\GPU Process Memory(*)\Shared Usage").CounterSamples | ? { $ids -contains [int]($_.InstanceName -replace "pid_(\d+)_.*","`$1") } | % { if($_.Path -like "*dedicated*"){$d+=$_.CookedValue}else{$s+=$_.CookedValue} }; "Dedicated {0:N2} GB | Shared {1:N2} GB" -f ($d/1GB),($s/1GB); if($s -gt 1.2GB){"WARNING: part of the model is in RAM (20-60% slower). Close apps that use the GPU (browser...) and restart it; if it persists, reboot"}else{"OK"}'
      ;;
    test)
      # Tests in Tests/ (remaining args -> script), e.g.:
      #   llama test speed --model <model-id>
      local f=""
      case "$2" in
        speed)     f="speed.py" ;;
        vision)    f="vision.py" ;;
        benchmark) f="quick-benchmark.py" ;;
        context)   f="context-sweep.py" ;;
        sampling)  f="sampling-quality.py" ;;
        reasoning) f="reasoning-test.py" ;;
        agentic)   f="agentic-test.py" ;;
      esac
      if [ -n "$f" ]; then
        (cd "$TESTS" && PYTHONUTF8=1 python "$f" "${@:3}")
      else
        echo "Usage: llama test <test> [--model ID] [options]   (details in $LLM/Tests/README.md)"
        echo "  speed      generation and prompt processing at 2k/32k/64k"
        echo "  vision     1024 px image (profiles with mmproj)"
        echo "  benchmark  quick speed + correctness check"
        echo "  context    maximum practical context before speed drops"
        echo "  sampling   code quality per temp/top-p/top-k"
        echo "  reasoning  5 coding tasks with hidden tests and loop detection"
        echo "  agentic    4 mini-projects with tools and hidden tests"
      fi
      ;;
    *)
      echo "Router (Copilot and Open WebUI switch models on their own):"
      echo "  llama start [model]    starts the router in the background (default: $DEFAULT_MODEL)"
      echo "  llama status           router models and which one is loaded"
      echo "  llama stop             stops every llama-server"
      echo "  llama router [model]   like start, but in the foreground"
      echo "  Models: $(router_models)"
      echo ""
      echo "Utilities:"
      echo "  llama server [folder]  active llama.cpp build ($LLM/Servers, saved in llm.conf)"
      echo "  llama vram             checks whether the model fits entirely in VRAM"
      echo "  llama test <test>      speed | vision | benchmark | context | sampling | reasoning | agentic"
      ;;
  esac
}
