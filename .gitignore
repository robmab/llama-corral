# Models and llama.cpp builds: several GB each, downloaded separately.
# The folders are kept (.gitkeep) so the layout exists after cloning.
Models/*
!Models/.gitkeep
Servers/*
!Servers/.gitkeep

# Local configuration (the *.example files are versioned instead)
llm.conf
aliases.sh
Router/models.ini

# Compiled launcher: built from Router/webui/LocalLLM-Launcher.ps1 with PS2EXE
# (command in Router/webui/README.md)
*.exe

# Generated at runtime
logs/
.webui_secret_key
__pycache__/
*.pyc
Tests/results-*.json
Tests/agentic-failures-*/

# Windows
*.lnk
Thumbs.db
desktop.ini
