# Normalize line endings in the repo.
* text=auto

# Bash scripts always LF: Git Bash will not run them with CRLF.
*.sh  text eol=lf
*.conf text eol=lf
*.example text eol=lf
# models.ini is read by llama-server: keep it free of CRLF.
*.ini text eol=lf

# The PowerShell launcher uses CRLF, as usual on Windows.
*.ps1 text eol=crlf

*.gguf binary
*.exe  binary
